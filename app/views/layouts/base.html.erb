<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <title><%= custom_title(yield(:page_title).presence) %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag :meta, name: 'viewport', content: 'width=device-width, initial-scale=1' %>
    <%= tag :meta, name: 'theme-color', content: '#0b0c0c' %>

    <link rel="mask-icon" href="govuk-mask-icon.svg" color="#0b0c0c">
    <%= favicon_link_tag 'favicon.ico', type: nil, sizes: "48x48" %>
    <%= favicon_link_tag 'favicon.svg', type: 'image/svg+xml', sizes: "48x48" %>
    <%= favicon_link_tag 'govuk-icon-mask.svg', rel: 'mask-icon', color: "#0b0c0c", type: nil %>
    <%= favicon_link_tag 'govuk-icon-180.png', rel: 'apple-touch-icon', type: nil %>

    <%= tag :meta, property: 'og:image', content: 'govuk-opengraph-image.png' %>

    <%= stylesheet_link_tag "main" %>
    <%= javascript_include_tag "main", defer: true %>
  </head>

  <body class="govuk-template__body">
    <%= javascript_tag nonce: true do %>
      document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    <% end %>

    <%= govuk_skip_link %>

    <%= custom_header %>
    <%= custom_service_navigation %>

    <div class="govuk-width-container">
      <% unless is_identity_journey? %>
        <%= govuk_phase_banner(tag: { text: "Beta" }) do %>
          This is a new service – <a class="govuk-link" href="mailto:<%= t('service.email') %>">your feedback will help us to improve it</a>.
        <% end %>
      <% end %>
      <%= govuk_back_link(href: yield(:back_link_url)) unless yield(:back_link_url).blank? %>

      <%= yield(:before_content) %>

      <main class="govuk-main-wrapper" id="main-content" role="main">
        <% if FeatureFlag.active?(:tps_contact_banner) %>
          <%# The design system wants banners as wide as the page content, which is two-thirds on our pages %>
          <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
              <%# Its own title id, or a flash banner on the same page would be labelled "Important" too %>
              <%= govuk_notification_banner(title_text: "Important", title_id: "tps-contact-banner-title") do %>
                <p class="govuk-body">Due to current issues on the Teachers’ Pension Portal, please contact them directly for access issues, updating details or if your Teacher Reference Number (TRN) is not recognised by their service. Telephone: 0345 6066166 or international call +44 1227 213243.</p>
              <% end %>
            </div>
          </div>
        <% end %>
        <%= render(FlashMessageComponent.new(flash: flash)) %>
        <%= content_for?(:content) ? yield(:content) : yield %>
      </main>
    </div>

    <%= govuk_footer(
      meta_items_title: 'Footer links',
      meta_items: {
        'Accessibility': 'https://accessibility-statements.education.gov.uk/s/42',
        'Cookies': '/cookies',
        'Privacy': 'https://www.gov.uk/government/publications/privacy-information-education-providers-workforce-including-teachers'
      }) %>
  </body>
</html>
